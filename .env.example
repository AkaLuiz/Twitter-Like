# Copie esse arquivo para ".env" (que já está no .gitignore) e ajuste os valores.

# Senha do usuário root do MySQL, usada pelo container do banco e pelo backend.
MYSQL_ROOT_PASSWORD=root

# Chave usada para assinar os tokens JWT. Troque por um valor aleatório em produção.
JWT_SECRET=chave-de-desenvolvimento-trocar-em-producao-0123456789abcdef
